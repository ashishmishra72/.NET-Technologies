}


/* NAVBAR */

.navbar {
    height: 60px;
}

.navbar-brand {
    font-size: 18px;
    font-weight: 500;
}


/* MAIN CONTAINER */

.product-container {
    max-width: 1100px;
    margin: 20px auto 100px;
}


/* HEADER */

.catalog-header {
    min-height: 137px;

    padding: 28px 34px;

    border-radius: 12px;

    display: flex;
    align-items: center;
    justify-content: space-between;

    background: linear-gradient(
        110deg,
        #1769f5,
        #5221f2
    );

    color: white;

    box-shadow: 0 8px 20px rgba(0,0,0,.15);
}


.catalog-title {
    display: flex;
    align-items: center;
    gap: 16px;
}


.catalog-title h1 {
    margin: 0;

    font-size: 32px;
    font-weight: 700;
}


.catalog-title p {
    margin: 8px 0 0;

    font-size: 14px;

    color: #e7eaff;
}


.shopping-icon {
    font-size: 38px;
}


.add-product {
    color: #2671dc;

    font-weight: 600;

    padding: 10px 20px;

    border-radius: 7px;

    border: none;
}


/* PRODUCT COUNT */

.product-count {
    display: inline-block;

    margin: 25px 0 20px;

    padding: 12px 18px;

    background: white;

    border-radius: 8px;

    box-shadow: 0 3px 12px rgba(0,0,0,.08);
}


/* PRODUCT CARD */

.product-card {
    background: white;

    border-radius: 14px;

    overflow: hidden;

    box-shadow: 0 5px 18px rgba(0,0,0,.08);

    transition: .2s;
}


.product-card:hover {
    transform: translateY(-3px);

    box-shadow: 0 8px 25px rgba(0,0,0,.13);
}


/* IMAGE */

.product-image {
    height: 102px;

    display: flex;
    align-items: center;
    justify-content: center;

    background: linear-gradient(
        120deg,
        #edf3ff,
        #f0eaff
    );
}


.cart-icon {
    font-size: 42px;
}


/* CONTENT */

.product-content {
    padding: 22px 20px 20px;
}


.product-heading {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
}


.product-heading h3 {
    margin: 0;

    font-size: 18px;
    font-weight: 700;
}


.category {
    background: #eaf3ff;

    color: #2875d5;

    padding: 6px 11px;

    border-radius: 15px;

    font-size: 12px;

    white-space: nowrap;
}


.price {
    color: #087c4b;

    font-size: 20px;

    font-weight: 700;

    margin-top: 10px;
}


.description {
    color: #777;

    margin-top: 10px;

    min-height: 23px;
}


.product-content hr {
    margin-top: 28px;

    border: 0;

    border-top: 1px solid #ddd;
}


/* BUTTONS */

.product-actions {
    display: flex;

    justify-content: space-between;

    margin-top: 14px;
}


.btn {
    border-radius: 6px;

    font-weight: 500;
}


.btn-details {
    background: #0969e8;

    color: white;
}


.btn-details:hover {
    background: #0759c9;

    color: white;
}


.btn-delete {
    background: #dc3545;

    color: white;
}


.btn-delete:hover {
    background: #bb2534;

    color: white;
}


/* FORM */

.form-container {
    max-width: 750px;

    margin: 40px auto;
}


.form-card {
    background: white;

    padding: 35px;

    border-radius: 12px;

    box-shadow: 0 5px 20px rgba(0,0,0,.08);
}


.form-card h1 {
    margin-bottom: 8px;
}


.form-header {
    margin-bottom: 30px;
}


.form-header p {
    color: #777;
}


.form-control {
    min-height: 45px;

    border-radius: 6px;
}


.form-buttons {
    display: flex;

    justify-content: flex-end;

    gap: 10px;

    margin-top: 25px;
}


.delete-product {
    background: #fff5f5;

    border: 1px solid #ffd0d0;

    padding: 20px;

    border-radius: 8px;

    margin-top: 20px;
}


/* FOOTER */

.footer {
    position: fixed;

    bottom: 0;

    width: 100%;

    background: #f8f9fa;

    border-top: 1px solid #ddd;

    padding: 14px 0;

    color: #777;
