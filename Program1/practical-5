<%@ Page Language="C#" AutoEventWireup="true"
    CodeBehind="EmployeeCalendar.aspx.cs"
    Inherits="EmployeeLeave.EmployeeCalendar" %>

<!DOCTYPE html>
<html>
<head runat="server">
    <title>Employee Calendar</title>

    <style>
        body {
            font-family: Arial;
        }

        .calendar {
            width: 260px;
        }

        .selected {
            margin-top: 15px;
        }
    </style>
</head>

<body>
    <form id="form1" runat="server">

        <h2>Employee Calendar</h2>

        <asp:Calendar ID="Calendar1"
            runat="server"
            CssClass="calendar"
            OnSelectionChanged="Calendar1_SelectionChanged">

            <TitleStyle BackColor="#CCCCCC" />
        </asp:Calendar>

        <div class="selected">
            <asp:Label ID="Label1"
                runat="server"
                Text="Selected Date">
            </asp:Label>

            <br />

            <asp:TextBox ID="txtSelectedDate"
                runat="server">
            </asp:TextBox>
        </div>

        <br />

        <asp:HyperLink ID="lnkLeave"
            runat="server"
            NavigateUrl="LeaveApplication.aspx"
            Text="Apply for Leave">
        </asp:HyperLink>

    </form>
</body>
</html>
using System;

namespace EmployeeLeave
{
    public partial class EmployeeCalendar : System.Web.UI.Page
    {
        protected void Calendar1_SelectionChanged(object sender, EventArgs e)
        {
            txtSelectedDate.Text =
                Calendar1.SelectedDate.ToString("dd/MM/yyyy");
        }
    }
}

 // leave application code 

 <%@ Page Language="C#" AutoEventWireup="true"
    CodeBehind="LeaveApplication.aspx.cs"
    Inherits="EmployeeLeave.LeaveApplication" %>

<!DOCTYPE html>
<html>
<head runat="server">
    <title>Leave Application</title>

    <style>
        body {
            font-family: Arial;
            background-color: #f5f6f8;
        }

        .container {
            width: 500px;
            margin: 50px auto;
            background: white;
            padding: 25px;
            border-radius: 8px;
            box-shadow: 0 2px 10px #ccc;
        }

        h2 {
            margin-bottom: 25px;
        }

        label {
            font-weight: bold;
            display: block;
            margin-top: 15px;
            margin-bottom: 5px;
        }

        .input {
            width: 100%;
            height: 35px;
            box-sizing: border-box;
        }

        .reason {
            width: 100%;
            height: 80px;
            box-sizing: border-box;
        }

        .btn {
            width: 100%;
            height: 38px;
            background-color: #0864b5;
            color: white;
            border: none;
            margin-top: 15px;
            cursor: pointer;
        }

        .success {
            color: green;
            margin-top: 15px;
        }
    </style>
</head>

<body>

<form id="form1" runat="server">

    <div class="container">

        <h2>Leave Application</h2>

        <asp:Label ID="lblName"
            runat="server"
            Text="Employee Name">
        </asp:Label>

        <asp:TextBox ID="txtName"
            runat="server"
            CssClass="input">
        </asp:TextBox>


        <asp:Label ID="lblLeaveType"
            runat="server"
            Text="Leave Type">
        </asp:Label>

        <asp:DropDownList ID="ddlLeaveType"
            runat="server"
            CssClass="input">

            <asp:ListItem>Casual Leave</asp:ListItem>
            <asp:ListItem>Sick Leave</asp:ListItem>
            <asp:ListItem>Earned Leave</asp:ListItem>
            <asp:ListItem>Emergency Leave</asp:ListItem>

        </asp:DropDownList>


        <asp:Label ID="lblFrom"
            runat="server"
            Text="From Date">
        </asp:Label>

        <asp:TextBox ID="txtFromDate"
            runat="server"
            TextMode="Date"
            CssClass="input">
        </asp:TextBox>


        <asp:Label ID="lblTo"
            runat="server"
            Text="To Date">
        </asp:Label>

        <asp:TextBox ID="txtToDate"
            runat="server"
            TextMode="Date"
            CssClass="input">
        </asp:TextBox>


        <asp:Label ID="lblReason"
            runat="server"
            Text="Reason">
        </asp:Label>

        <asp:TextBox ID="txtReason"
            runat="server"
            TextMode="MultiLine"
            CssClass="reason">
        </asp:TextBox>


        <asp:Button ID="btnApply"
            runat="server"
            Text="Apply Leave"
            CssClass="btn"
            OnClick="btnApply_Click" />

        <asp:Label ID="lblMessage"
            runat="server"
            CssClass="success">
        </asp:Label>

    </div>

</form>

</body>
</html>

using System;

namespace EmployeeLeave
{
    public partial class LeaveApplication : System.Web.UI.Page
    {
        protected void btnApply_Click(object sender, EventArgs e)
        {
            if (txtName.Text == "" ||
                txtFromDate.Text == "" ||
                txtToDate.Text == "" ||
                txtReason.Text == "")
            {
                lblMessage.ForeColor =
                    System.Drawing.Color.Red;

                lblMessage.Text =
                    "Please fill all the fields.";

                return;
            }

            lblMessage.ForeColor =
                System.Drawing.Color.Green;

            lblMessage.Text =
                "Leave application submitted successfully.";
        }
    }
}
